{
  "name": "vue3-components",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/vue3-components.cjs.js",
  "module": "./dist/vue3-components.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue3-components.es.js",
      "require": "./dist/vue3-components.cjs.js"
    },
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && node scripts/copy-style.mjs"
  },
  "peerDependencies": {
    "element-plus": "^2.14.6",
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@vc/hooks": "workspace:*",
    "@vc/utils": "workspace:*"
  },
  "devDependencies": {
    "element-plus": "^2.14.6",
    "vite-plugin-dts": "^5.1.1"
  }
}
